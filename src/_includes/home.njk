{% macro icon(name) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == 'scholar' -%}
<path d="M2 9.5 12 5l10 4.5-10 4.5z"/><path d="M6 11.8V16c0 1.6 2.7 2.9 6 2.9s6-1.3 6-2.9v-4.2"/><path d="M20.6 10.2v5"/>
{%- elif name == 'github' -%}
<path d="M9 7 4 12l5 5"/><path d="m15 7 5 5-5 5"/>
{%- elif name == 'dblp' -%}
<path d="M4 4.5h5.5A2.5 2.5 0 0 1 12 7v13a2.5 2.5 0 0 0-2.5-2.5H4z"/><path d="M20 4.5h-5.5A2.5 2.5 0 0 0 12 7v13a2.5 2.5 0 0 1 2.5-2.5H20z"/>
{%- elif name == 'orcid' -%}
<rect x="3" y="3" width="18" height="18" rx="5"/><path d="M8.2 8.4v7.2"/><circle cx="8.2" cy="10.6" r="0.9" fill="currentColor" stroke="none"/><path d="M11.8 8.4v7.2h2.1a3.6 3.6 0 0 0 0-7.2z"/>
{%- elif name == 'mail' -%}
<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.6 6.8 8.4 6.3 8.4-6.3"/>
{%- else -%}
<path d="M10 13a4 4 0 0 0 5.7 0l3-3A4 4 0 0 0 13 4.4l-1.4 1.4"/><path d="M14 11a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 19.6l1.4-1.4"/>
{%- endif -%}
</svg>
{%- endmacro -%}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <meta name="author" content="{{ site.name_zh }} ({{ site.name_en }})">
  <meta property="og:title" content="{{ site.title }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:type" content="profile">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build }}">
  <script>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <header class="hero">
    <img class="avatar" src="{{ site.avatar }}" alt="头像">
    <div class="hero-text">
      <h1>{{ site.name_zh }}<span class="en">{{ site.name_en }}</span></h1>
      <p class="tagline">{{ site.role }}{% if site.affiliation %} · {{ site.affiliation }}{% endif %}</p>
      <p class="meta">{{ site.location }}{% if site.email %} · <a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}</p>
      {%- if site.interests and site.interests.length %}
      <p class="research"><span class="label">研究方向：</span>{% for i in site.interests %}<strong>{{ i }}</strong>{% if not loop.last %}、{% endif %}{% endfor %}</p>
      {%- endif %}
      <ul class="social">
        {%- for l in site.links %}
        <li>
          <a href="{{ l.url }}"{{ l.url | target | safe }}>{{ l.label }}</a>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </header>

  <nav class="nav" aria-label="页面导航">
    <div class="nav-inner">
      <a href="#experience">经历</a>
      <a href="#projects">项目</a>
      <a href="#map">地图</a>
      <a href="#papers">论文</a>
      <button class="theme-btn" type="button" aria-label="切换深色模式">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </nav>

  <main id="top">
    <section id="experience">
      <h2>工作与教育经历</h2>
      <ul class="pubs">
        {%- for e in experience %}
        <li class="pub"{% if p.map %} data-map="{{ p.map | join(' ') }}"{% endif %}>
          <p class="line"><span class="when">{{ e.period }}</span> · <span class="what">{{ e.org }}</span>{% if e.dept %} · <span class="mid">{{ e.dept }}</span>{% endif %} · <span class="role">{{ e.role }}</span></p>
        </li>
        {%- endfor %}
      </ul>
    </section>

    {%- if projects and projects.length %}
    <section id="projects">
      <h2>科研项目</h2>
      <ul class="pubs">
        {%- for p in projects %}
        <li class="pub"{% if p.map %} data-map="{{ p.map | join(' ') }}"{% endif %}>
          <p class="line"><span class="when">{{ p | years }}</span> · <span class="what">{{ p.source }}</span> · <span class="role">{{ p.role }}</span></p>
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    <section id="map">
      <h2>研究地图</h2>
      <div class="rmap-wrap">{% include "research-map.svg" %}</div>
      <div class="map-tip" id="map-tip">点一下试试</div>
    </section>
    <section id="papers">
      <h2>论文</h2>
      <div class="filter-bar" id="filter-bar">
        <span>筛选：<b id="filter-name"></b></span>
        <span class="filter-count" id="filter-count"></span>
        <button type="button" class="filter-clear" id="filter-clear">清除</button>
      </div>
      <ol class="pubs pubs--flow">
        {%- for p in publications | byYearDesc %}
        <li class="pub"{% if p.map %} data-map="{{ p.map | join(' ') }}"{% endif %}>
          <p class="t"><span class="yr">{{ p.year }}</span>{{ p.title }}</p>
          <p class="a">{{ p.authors | emph(p.corresponding) | safe }}</p>
          <p class="v">{{ p.venue }}{% if p.pdf %} · <a href="{{ p.pdf }}" target="_blank" rel="noopener">PDF</a>{% endif %}{% if p.code %} · <a href="{{ p.code }}" target="_blank" rel="noopener">Code</a>{% endif %}</p>
        </li>
        {%- endfor %}
      </ol>
    </section>
  </main>

  <script src="/assets/js/main.js?v={{ build }}"></script>
</body>
</html>
